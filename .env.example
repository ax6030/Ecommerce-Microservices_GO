# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# User Service DB
USER_DB_DSN=user:password@tcp(user-db:3306)/userdb?parseTime=true

# Product Service DB
PRODUCT_DB_DSN=user:password@tcp(product-db:3306)/productdb?parseTime=true

# Order Service DB
ORDER_DB_DSN=user:password@tcp(order-db:3306)/orderdb?parseTime=true

# NATS
NATS_URL=nats://nats:4222

# gRPC endpoints (for api-gateway)
USER_SERVICE_ADDR=user-service:50051
PRODUCT_SERVICE_ADDR=product-service:50052
ORDER_SERVICE_ADDR=order-service:50053
